{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mint Starter Kit",
  "colors": {
    "primary": "#2559FE",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "icon": "book-open-cover",
          "color": {
            "light": "#2559fe",
            "dark": "#2559fe"
          },
          "href": "https://docs.stagewise.io/"
        },
        {
          "anchor": "Newsroom",
          "icon": "newspaper",
          "href": "https://stagewise.io/news"
        },
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/stagewise-io/stagewise"
        },
        {
          "anchor": "Discord",
          "icon": "discord",
          "href": "https://stagewise.io/socials/discord"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "best-practices"
            ]
          },
          {
            "group": "Agent configuration",
            "pages": [
              "agent/models-and-providers",
              "agent/byok-setup",
              "agent/custom-providers",
              "agent/custom-models",
              "agent/skills-and-context",
              "agent/plugins"
            ]
          },
          {
            "group": "Browsing",
            "pages": [
              "browsing/general-settings",
              "browsing/history-and-downloads",
              "browsing/permissions",
              "browsing/clear-data"
            ]
          },
          {
            "group": "Features",
            "pages": [
              "features/diff-review",
              "features/dom-context-selector",
              "features/keyboard-shortcuts"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "account/authentication",
              "account/about"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoint examples",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/webhook"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:sales@stagewise.io"
      },
      {
        "label": "Website",
        "href": "https://stagewise.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://console.stagewise.io"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/stagewise_io",
      "github": "https://github.com/stagewise-io/stagewise",
      "linkedin": "https://linkedin.com/company/stagewise-io",
      "discord": "https://stagewise.io/socials/discord"
    }
  }
}
